package practice;

class Parent {
    int x = 10;
}
public class Child extends Parent {
    int x = 20;

    void display() {
        System.out.println("Parent x: " + super.x);
        System.out.println("Child x: " + this.x);
    }
    public static void main(String[] args) {
        Child c = new Child();
        c.display();
    }
}
